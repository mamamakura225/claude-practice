{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server . -p 8080 -c-1 --silent",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/apps/dtask/",
        "http://localhost:8080/apps/piano-pet/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
