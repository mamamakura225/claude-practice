{
  "git": { "deploymentEnabled": false },
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/dtask/(.*)", "destination": "/apps/dtask/$1" },
    { "source": "/piano-pet/(.*)", "destination": "/apps/piano-pet/$1" }
  ]
}
